<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bw_access_grant_view_list" model="ir.ui.view">
        <field name="name">bw.access.grant.view.list</field>
        <field name="model">bw.access.grant</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="partner_id" optional="hide"/>
                <field name="system"/>
                <field name="profile"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'provisioned'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'manual'"/>
                <field name="external_ref" optional="hide"/>
                <field name="date_start" optional="hide"/>
                <field name="expiry_date"/>
                <field name="is_exception"/>
                <field name="vault_ref" optional="show"/>
            </list>
        </field>
    </record>

    <record id="bw_access_grant_view_form" model="ir.ui.view">
        <field name="name">bw.access.grant.view.form</field>
        <field name="model">bw.access.grant</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="partner_id"/>
                            <field name="system"/>
                            <field name="profile"/>
                            <field name="vault_ref"/>
                            <field name="external_ref"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="expiry_date"/>
                            <field name="is_exception"/>
                            <field name="exception_reason" invisible="not is_exception" required="is_exception"/>
                            <field name="active" invisible="active"/>
                        </group>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Context, scope, who approved..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bw_access_grant_view_search" model="ir.ui.view">
        <field name="name">bw.access.grant.view.search</field>
        <field name="model">bw.access.grant</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="system"/>
                <filter name="filter_todo" string="To do"
                        domain="[('state', 'in', ('pending', 'failed', 'manual'))]"/>
                <filter name="filter_expired" string="Expired"
                        domain="[('expiry_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_exceptions" string="Exceptions"
                        domain="[('is_exception', '=', True)]"/>
                <filter name="filter_archived" string="Archived (revoked)"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_system" string="System" context="{'group_by': 'system'}"/>
                    <filter name="group_profile" string="Profile" context="{'group_by': 'profile'}"/>
                    <filter name="group_employee" string="Worker" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bw_access_grant_action" model="ir.actions.act_window">
        <field name="name">Access Grants</field>
        <field name="res_model">bw.access.grant</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register an access grant</p>
            <p>Metadata and 1Password references only. Secrets never live here.</p>
        </field>
    </record>

    <menuitem id="bw_access_grant_menu"
              name="Access Grants"
              parent="hr.menu_hr_root"
              action="bw_access_grant_action"
              groups="hr.group_hr_user"
              sequence="90"/>
</odoo>
